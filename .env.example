# Supabase (Project Settings > API)
# Usadas SOMENTE no servidor — nunca prefixe com NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Sessão (sign-in): chave HS256 do JWT do cookie, 32+ caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=<session-secret>
